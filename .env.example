# Chép tệp này thành .env (cùng thư mục) rồi điền giá trị.
# Tệp .env chỉ nằm trên máy bạn; đừng đưa nó lên GitHub hay gửi cho người khác.

# Auth key 32 ký tự hex của vòng tay (có hoặc không có 0x)
MIBAND6_AUTH_KEY=

# Không bắt buộc: mã thiết bị Bluetooth (xem ở trang Kết nối sau khi quét) để khỏi phải quét lại
MIBAND6_ADDRESS=

# Không bắt buộc: auto | classic | 2021
MIBAND6_PROTOCOL=auto
